generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Proyecto {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  creadoEn    DateTime @default(now())
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nombre    String?
  creadoEn  DateTime @default(now())

  @@index([email])
}

model IntakeApplication {
  id            Int      @id @default(autoincrement())
  preferredName String
  phoneCode     String
  phoneNumber   String
  fullPhone     String
  age           Int
  feelings      String
  priorSessions String
  contactMethod String
  creadoEn      DateTime @default(now())

  @@index([creadoEn(sort: Desc)])
}