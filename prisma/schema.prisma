datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Tu primera tabla de ejemplo
model Proyecto {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  creadoEn    DateTime @default(now())
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Aquí guardaremos la contraseña encriptada
  nombre    String?
  creadoEn  DateTime @default(now())
}